APP_NAME=Norocel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://norocel.noros.net
APP_TIMEZONE=UTC
APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ck85651_norocel
DB_USERNAME=ck85651_norocel
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=norocel.noros.net
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# Set an actual sender on your domain before deployment.
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=Norocel
LOG_CHANNEL=stack
LOG_LEVEL=warning
FILESYSTEM_DISK=local
