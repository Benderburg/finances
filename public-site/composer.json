{
  "name": "noros/norocel-public-site",
  "type": "project",
  "description": "Norocel public website using Noros core and CMS",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "filament/filament": "^5.0",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0",
    "noros/core": "dev-main",
    "noros/cms": "dev-main"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "larastan/larastan": "^3.0",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade",
      "@php artisan vendor:publish --tag=noros-cms-assets --force --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "url": "packages/noros-core",
      "type": "path",
      "options": {
        "symlink": false,
        "versions": {
          "noros/core": "dev-main",
          "noros/cms": "dev-main"
        }
      }
    },
    {
      "url": "packages/noros-cms",
      "type": "path",
      "options": {
        "symlink": false,
        "versions": {
          "noros/core": "dev-main",
          "noros/cms": "dev-main"
        }
      }
    }
  ]
}
