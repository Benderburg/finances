{
  "name": "noros/cms",
  "description": "Composable Noros content management",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "filament/filament": "^5.0",
    "noros/core": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "Noros\\Cms\\": "src/",
      "Noros\\Cms\\Database\\Factories\\": "database/factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Noros\\Cms\\CmsServiceProvider"
      ]
    }
  }
}
